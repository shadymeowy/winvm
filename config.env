# winslim configuration. Plain KEY=value lines; $VAR / ${VAR} and a leading ~ expand.
# Precedence: environment variables > config.local.env (git-ignored) > this file.

# --- where big files live (ISOs, disks, caches) -------------------------------
DATA_DIR=~/Others/vm

# --- Windows source -----------------------------------------------------------
WIN_ISO=                          # official Win10/11 ISO; empty = newest Win*.iso in $DATA_DIR/iso
WIN_EDITION=Windows 11 Pro        # exactly as listed by `./winvm editions`
WIN_INDEX=                        # or pick the edition by index instead

# --- guest identity -----------------------------------------------------------
WIN_HOSTNAME=WINSLIM              # max 15 chars
WIN_USER=user                     # local administrator
WIN_PASSWORD=winslim              # console/RDP; SSH uses keys
WIN_TIMEZONE=W. Europe Standard Time   # `tzutil /l` names
WIN_LOCALE=en-US
WIN_KEYBOARD=0409:00000409        # e.g. 041f:0000041f = Turkish Q

# --- VM hardware --------------------------------------------------------------
INSTANCE=main                     # default instance for commands without -i
DISK_SIZE=64G                     # virtual size; qcow2 is thin, only used blocks count
RAM=4G
CPUS=4
COMPRESS_BASE=1                   # zstd-compress the golden base layer
# Fixed SMBIOS UUID: Windows/Office activation is tied to the hardware ID,
# so every instance on every layer looks like the same machine.
VM_UUID=39c74881-4470-47a8-a7a6-879b7a7753b8

# --- host <-> guest (instance n gets port + n, the first one n = 0) -----------
SSH_PORT=2222                     # 127.0.0.1:SSH_PORT -> guest:22
RDP_PORT=3390                     # 127.0.0.1:RDP_PORT -> guest:3389 (empty = off)
VNC_DISPLAY=30                    # headless console on 127.0.0.1:5900+N (empty = off)
SHARE_DIR=$DATA_DIR/share         # exported to guests as \\10.0.2.4\qemu = C:\host
SSH_EXTRA_PUBKEYS=~/.ssh/id_ed25519.pub   # also authorized in the guest (space-separated)

# --- pinned downloads (reproducibility) ---------------------------------------
VIRTIO_URL=https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/archive-virtio/virtio-win-0.1.302-1/virtio-win-0.1.302.iso
VIRTIO_SHA256=303f7ae40dad495d6ae474fdc571df58958a4dbc5c37a522d80f9a203867949d
OPENSSH_URL=https://github.com/PowerShell/Win32-OpenSSH/releases/download/10.0.0.0p2-Preview/OpenSSH-Win64-v10.0.0.0.msi
OPENSSH_SHA256=ddec9c53864280759cf9f74791cefd387100e3946aa849a1c138a4ed1b96b7d9

# --- tools --------------------------------------------------------------------
QEMU=qemu-system-x86_64
QEMU_IMG=/usr/bin/qemu-img        # absolute: another qemu-img (e.g. Android SDK) may shadow it on PATH
OVMF_CODE=                        # empty = autodetect (non-secure-boot build)
OVMF_VARS=
WIMLIB_THREADS=2                  # `iso` export threads; solid LZMS needs ~1 GiB RAM each
MEM_RESERVE=1024                  # MiB of host RAM that must stay free when starting VMs/exports

# --- debloat ------------------------------------------------------------------
WIN_STRIP_PAYLOADS=1              # strip payloads of disabled features (re-enabling needs install media)
WIN_COMPACT=0                     # 1 = CompactOS in the guest; 0 = raw, zstd-compressed by qcow2 (smaller)
WIN_REMOVE_WEBVIEW=1              # remove the Edge WebView2 runtime (~1 GB)
WINSLIM_DEBUG=0                   # 1 = a WinPE failure drops to a shell instead of powering off
