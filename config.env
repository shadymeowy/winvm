# winslim configuration (defaults, committed).
# Override anything in config.local.env (git-ignored) or via environment variables.
# Values are bash; ${VAR:-default} means "env var wins".

# --- where big files live (ISOs, disks, caches) -------------------------------
DATA_DIR=${DATA_DIR:-$HOME/Others/vm}

# --- Windows source -----------------------------------------------------------
# Path to an official Windows 10/11 ISO. Empty = newest Win*.iso in $DATA_DIR/iso.
WIN_ISO=${WIN_ISO:-}
# Edition name exactly as listed by `./winvm editions`.
WIN_EDITION=${WIN_EDITION:-Windows 11 Pro}

# --- guest identity -----------------------------------------------------------
WIN_HOSTNAME=${WIN_HOSTNAME:-WINSLIM}          # max 15 chars
WIN_USER=${WIN_USER:-user}                     # local administrator
WIN_PASSWORD=${WIN_PASSWORD:-winslim}          # used for console/RDP; SSH uses keys
WIN_TIMEZONE=${WIN_TIMEZONE:-W. Europe Standard Time}   # `tzutil /l` names
WIN_LOCALE=${WIN_LOCALE:-en-US}
WIN_KEYBOARD=${WIN_KEYBOARD:-0409:00000409}    # e.g. 041f:0000041f = Turkish Q

# --- VM hardware --------------------------------------------------------------
VM_NAME=${VM_NAME:-winslim}
DISK_SIZE=${DISK_SIZE:-64G}        # virtual size; qcow2 is thin, only used blocks count
RAM=${RAM:-4G}
CPUS=${CPUS:-4}
COMPRESS_BASE=${COMPRESS_BASE:-1}  # zstd-compress the golden base image

# --- host <-> guest -----------------------------------------------------------
SSH_PORT=${SSH_PORT:-2222}         # 127.0.0.1:SSH_PORT -> guest:22
RDP_PORT=${RDP_PORT:-3390}         # 127.0.0.1:RDP_PORT -> guest:3389 (empty = off)
VNC_DISPLAY=${VNC_DISPLAY:-30}     # headless console on 127.0.0.1:5900+N (empty = off)
SHARE_DIR=${SHARE_DIR:-$DATA_DIR/share}   # exported to guest as \\10.0.2.4\qemu = C:\host

# --- pinned downloads (reproducibility) ---------------------------------------
VIRTIO_URL=${VIRTIO_URL:-https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/archive-virtio/virtio-win-0.1.302-1/virtio-win-0.1.302.iso}
VIRTIO_SHA256=${VIRTIO_SHA256:-303f7ae40dad495d6ae474fdc571df58958a4dbc5c37a522d80f9a203867949d}
OPENSSH_URL=${OPENSSH_URL:-https://github.com/PowerShell/Win32-OpenSSH/releases/download/10.0.0.0p2-Preview/OpenSSH-Win64-v10.0.0.0.msi}
OPENSSH_SHA256=${OPENSSH_SHA256:-ddec9c53864280759cf9f74791cefd387100e3946aa849a1c138a4ed1b96b7d9}

# --- tools --------------------------------------------------------------------
QEMU=${QEMU:-qemu-system-x86_64}
QEMU_IMG=${QEMU_IMG:-/usr/bin/qemu-img}
OVMF_CODE=${OVMF_CODE:-}           # empty = autodetect (non-secure-boot build)
OVMF_VARS=${OVMF_VARS:-}
LIBVIRT_URI=${LIBVIRT_URI:-qemu:///session}
# --- debloat ------------------------------------------------------------------
WIN_STRIP_PAYLOADS=${WIN_STRIP_PAYLOADS:-1}
WIN_COMPACT=${WIN_COMPACT:-0}              # 1 = CompactOS (WOF) in guest; 0 = raw, zstd-compressed by qcow2 (smaller on host)
WIN_REMOVE_WEBVIEW=${WIN_REMOVE_WEBVIEW:-1}  # remove the Edge WebView2 runtime (~1 GB); apps that need it reinstall it  # strip payloads of disabled optional features (re-enable needs install media)
