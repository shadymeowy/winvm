@command()
def cmd_fetch(a=None):
    """download the pinned virtio-win ISO + OpenSSH MSI (sha256-checked)"""
    CACHE.mkdir(parents=True, exist_ok=True)
    ISOS.mkdir(parents=True, exist_ok=True)

    def ok(f: Path, want: str) -> bool:
        if not f.exists():
            return False
        h = hashlib.sha256()
        with f.open("rb") as fh:
            while chunk := fh.read(1 << 20):
                h.update(chunk)
        return h.hexdigest() == want

    for url, f, want in ((C.VIRTIO_URL, VIRTIO_ISO, C.VIRTIO_SHA256), (C.OPENSSH_URL, OPENSSH_MSI, C.OPENSSH_SHA256)):
        if ok(f, want):
            log(f"ok: {f.name}")
            continue
        log(f"downloading {f.name}")
        if shutil.which("aria2c"):
            run("aria2c", "-q", "-x8", "-s8", "--allow-overwrite=true", "--auto-file-renaming=false",
                "-d", f.parent, "-o", f.name, url)
        else:
            run("curl", "-fL", "--progress-bar", "-o", f, url)
        ok(f, want) or die(f"checksum mismatch: {f}")
    iso = win_iso(required=False)
    log(f"Windows ISO: {iso.name}") if iso else warn(f"no Windows ISO yet - put an official one into {ISOS}")


