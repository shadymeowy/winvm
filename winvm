#!/usr/bin/env python3
"""winvm - build and drive slim, unattended Windows VMs on QEMU/KVM.

Small files live in this repo (config, scripts, guest payload). Big ones in $DATA_DIR:

  iso/                  Microsoft ISO, winslim-boot.iso, winslim-standalone.iso
  images/layers/X.qcow2 read-only layer X, backed by the layer below ("base" = golden image)
  images/disks/X.qcow2  read-write working disk of instance X, backed by a layer
  run/X/                pidfile, sockets, logs, ports, firmware vars of instance X
  cache/  keys/  share/ pinned downloads, the SSH key the guest trusts, the SMB share
"""
from __future__ import annotations

