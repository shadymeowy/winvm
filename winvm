@command(arg("--standalone", action="store_true", help="install from the slim ISO (./winvm iso) - ~6 min"),
         arg("--gui", action="store_true", help="show the installer in a window"))
def cmd_install(a):
    """unattended install into a fresh disk -> golden layer 'base'"""
    need(C.QEMU, C.QEMU_IMG)
    if layer("base").exists():
        die("layer 'base' exists - ./winvm clean --base first to rebuild")
    if a.standalone:
        if not SLIM_ISO.exists():
            cmd_iso(a)
        cdroms = [SLIM_ISO]
    else:
        if not BOOT_ISO.exists():
            cmd_build()
        cdroms = [BOOT_ISO, win_iso()]                          # pe.cmd reads install.wim from CD 2
    IMAGES.mkdir(parents=True, exist_ok=True)
    INSTALL_DISK.unlink(missing_ok=True)
    run(C.QEMU_IMG, "create", "-q", "-f", "qcow2", INSTALL_DISK, C.DISK_SIZE)
    log("starting unattended install")
    serial = run_installer(INSTALL_DISK, cdroms, gui=a.gui)
    if "WINSLIM-FAIL" in serial:
        die(f"install failed - see {RUNS}/_install/install-serial.log (also C:\\Windows\\Setup on the disk)")
    if "WINSLIM-DONE" not in serial:
        die(f"install did not report WINSLIM-DONE; disk kept at {INSTALL_DISK}")
    finalize(INSTALL_DISK)


@command()
def cmd_iso(a=None):
    """build the standalone slim installer ISO from the debloated image ("iso to iso", ~1 h)"""
    # 1. boot a capture variant of the boot ISO: WinPE applies + services offline as usual,
    #    then captures the serviced C: to a spare partition and powers off
    # 2. pull the image out with libguestfs, recompress it on the host, 3. wrap it as an ISO
    need(C.QEMU, C.QEMU_IMG, "guestfish")
    if running():
        die("an instance is running - stop it first (capture VM + export need the RAM)")
    tree, cap = BUILD / "tree", BUILD / "capture.qcow2"
    stage_tree(tree, mode="capture")
    make_iso(tree, BUILD / "capture.iso", "WINSLIM")
    cap.unlink(missing_ok=True)
    run(C.QEMU_IMG, "create", "-q", "-f", "qcow2", cap, "80G")
    log("capture run: apply + offline debloat + capture (~25 min)")
    run_installer(cap, [BUILD / "capture.iso", win_iso()])
    iso_from_capture(cap, tree)
    log(f"standalone ISO: {SLIM_ISO} ({human(SLIM_ISO)}); install with ./winvm install --standalone")
    warn("this ISO wipes disk 0 without asking - it refuses to run on non-QEMU machines")


