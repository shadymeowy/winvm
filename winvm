PS_PROLOGUE = r"""$ProgressPreference = 'SilentlyContinue'
try { [Console]::OutputEncoding = [Text.UTF8Encoding]::new($false) } catch {}
$OutputEncoding = [Text.UTF8Encoding]::new($false)
function stdin { while ($null -ne ($l = [Console]::In.ReadLine())) { $l } }
"""


def guest_cwd() -> str | None:
    """The guest path of the host's cwd if it lies inside the share."""
    try:
        rel = Path.cwd().resolve().relative_to(SHARE.resolve())
    except ValueError:
        return None
    return "C:\\host" + "".join(f"\\{p}" for p in rel.parts)


def ps_quote(s: str) -> str:
    return "'" + s.replace("'", "''") + "'"


def encoded(script: str) -> str:
    """Remote command for the guest's PowerShell that runs `script` exactly as written:
    shipped as base64, so no quoting survives ssh, sshd and Windows command-line parsing."""
    b64 = base64.b64encode(script.encode()).decode()
    return f"iex ([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('{b64}')))"


@command(arg("cmd", nargs="*", metavar="CMD", help="PowerShell command line (as typed at the prompt)"),
         raw=True, aliases=("shell",))
def cmd_sh(a):
    """PowerShell in the guest: interactive, or run CMD and return its exit code

    ./winvm sh                          interactive shell
    ./winvm sh ipconfig /all            run a command line; PowerShell parses it
    ./winvm sh 'gci C:\\ | select Name'  one quoted argument = PowerShell code as is
    ./winvm sh notepad "a b.txt"        words with spaces stay one argument
    ./winvm sh -t python                -t: a terminal, for interactive programs
    cat x | ./winvm sh findstr foo      stdin reaches native programs; PowerShell code reads `stdin`
    ./winvm sh ipconfig | grep IPv4     output has Unix line endings

    The exit code is the command's. Started inside the share ($SHARE_DIR), the guest
    command runs in the matching C:\\host folder.
    """
    vm = current(a).up()
    tty = a.rest[:1] == ["-t"]
    words = a.rest[tty:]
    cwd = guest_cwd()
    cd = f"Set-Location -LiteralPath {ps_quote(cwd)}\n" if cwd else ""
    if not words:                                              # interactive shell
        os.execvp("ssh", vm.ssh("-t") + ([encoded(cd + "powershell -NoLogo")] if cwd else []))
    line = words[0] if len(words) == 1 else " ".join(ps_quote(w) if re.search(r"\s", w) else w for w in words)
    # $rc: the native program's exit code, or 1 for a failed cmdlet
    script = PS_PROLOGUE + cd + line + "\n$rc = if ($?) { 0 } elseif ($LASTEXITCODE) { $LASTEXITCODE } else { 1 }\n"
    return sh_tty(vm, script) if tty else sh_pipe(vm, script + "exit $rc\n")


def sh_tty(vm: VM, script: str) -> int:
    """Run with a terminal. Windows' sshd drops the exit code of terminal sessions, so the
    guest leaves it in a file that a second (multiplexed, cheap) call picks up."""
    rc = f"$env:TEMP\\winvm-{os.getpid()}.rc"
    sp.run(vm.ssh("-t") + [encoded(f"{script}Set-Content {rc} $rc\nexit $rc\n")])
    r = sp.run(vm.ssh("-o", "BatchMode=yes") + [encoded(f"Get-Content {rc}; Remove-Item {rc}")],
               stdin=sp.DEVNULL, stdout=sp.PIPE, stderr=sp.DEVNULL, text=True)
    return int(r.stdout.strip()) if r.stdout.strip().isdigit() else 1


def sh_pipe(vm: VM, script: str) -> int:
    """Run without a terminal: stdin passes through, stdout streams with CRLF turned into LF
    so host tools (grep, diff, ...) are happy."""
    proc = sp.Popen(vm.ssh("-o", "BatchMode=yes") + [encoded(script)], stdout=sp.PIPE)
    out, carry = sys.stdout.buffer, b""
    try:
        while chunk := proc.stdout.read1(1 << 16):
            chunk = carry + chunk
            carry = b"\r" if chunk.endswith(b"\r") else b""   # a CRLF may straddle two chunks
            out.write(chunk[: len(chunk) - len(carry)].replace(b"\r\n", b"\n"))
            out.flush()
        out.write(carry)
        out.flush()
    except BrokenPipeError:                                    # e.g. | head
        proc.kill()
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        return 141
    return proc.wait()


