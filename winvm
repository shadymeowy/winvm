REPO = Path(__file__).resolve().parent


# ------------------------------------------------------------------ output / processes

_COLOR = sys.stderr.isatty()


def _paint(code: str, s: str) -> str:
    return f"\033[{code}m{s}\033[0m" if _COLOR else s


def log(msg: str) -> None:
    print(_paint("1;32", "==>"), msg, file=sys.stderr)


def warn(msg: str) -> None:
    print(_paint("1;33", "warn:"), msg, file=sys.stderr)


def die(msg: str):
    print(_paint("1;31", "error:"), msg, file=sys.stderr)
    sys.exit(1)


def run(*cmd, check=True, quiet=False, **kw) -> sp.CompletedProcess:
    """Run an external tool; die naming it if it fails."""
    cmd = [str(c) for c in cmd]
    if quiet:
        kw.setdefault("stdout", sp.DEVNULL)
    r = sp.run(cmd, **kw)
    if check and r.returncode:
        die(f"{Path(cmd[0]).name} failed (exit {r.returncode}): {' '.join(cmd[1:])[:300]}")
    return r


def output(*cmd, **kw) -> str:
    return run(*cmd, stdout=sp.PIPE, text=True, **kw).stdout


def need(*tools: str) -> None:
    for t in tools:
        if not shutil.which(t):
            die(f"missing tool: {t}")


# ------------------------------------------------------------------ config & paths

def load_config() -> SimpleNamespace:
    """config.env < config.local.env < environment; values may use $VAR, ${VAR} and a leading ~."""
    cfg: dict[str, str] = {}

    def expand(v: str) -> str:
        v = re.sub(r"\$\{(\w+)\}|\$(\w+)", lambda m: cfg.get(m[1] or m[2], os.environ.get(m[1] or m[2], "")), v)
        return os.path.expanduser(v)

    for f in (REPO / "config.env", REPO / "config.local.env"):
        if not f.exists():
            continue
        for n, line in enumerate(f.read_text().splitlines(), 1):
            line = re.sub(r"(^|\s)#.*", "", line).strip()      # comments: '#' at start or after a space
            if not line:
                continue
            key, eq, val = (s.strip() for s in line.partition("="))
            if not eq or not re.fullmatch(r"[A-Z][A-Z0-9_]*", key):
                die(f"{f.name}:{n}: expected KEY=value")
            if len(val) > 1 and val[0] == val[-1] and val[0] in "'\"":
                val = val[1:-1]
            cfg[key] = expand(val)
    for key in cfg:                                           # environment wins
        if key in os.environ:
            cfg[key] = os.path.expanduser(os.environ[key])
    return SimpleNamespace(**cfg)


C = load_config()
DATA = Path(C.DATA_DIR)
CACHE, ISOS, IMAGES, KEYS, RUNS, BUILD = (DATA / d for d in ("cache", "iso", "images", "keys", "run", "build"))
LAYERS, DISKS = IMAGES / "layers", IMAGES / "disks"
SHARE = Path(C.SHARE_DIR)
BOOT_ISO, SLIM_ISO = ISOS / "winslim-boot.iso", ISOS / "winslim-standalone.iso"
INSTALL_DISK = IMAGES / "install.qcow2"
SSH_KEY = KEYS / "id_ed25519"
VIRTIO_ISO, OPENSSH_MSI = CACHE / Path(C.VIRTIO_URL).name, CACHE / Path(C.OPENSSH_URL).name

# virtio driver folders injected into Windows (w11/amd64 flavour)
VIRTIO_DRIVERS = "vioscsi viostor NetKVM Balloon vioserial viorng vioinput pvpanic fwcfg viogpudo".split()
HYPERV = ("hv-relaxed,hv-vapic,hv-spinlocks=0x1fff,hv-vpindex,hv-runtime,hv-time,hv-synic,"
          "hv-stimer,hv-frequencies,hv-tlbflush,hv-ipi,hv-reset")
OVMF_PAIRS = [  # (code, vars) of non-secure-boot builds, per distro
    ("/usr/share/edk2/ovmf/OVMF_CODE.fd", "/usr/share/edk2/ovmf/OVMF_VARS.fd"),
    ("/usr/share/OVMF/OVMF_CODE_4M.fd", "/usr/share/OVMF/OVMF_VARS_4M.fd"),
    ("/usr/share/OVMF/OVMF_CODE.fd", "/usr/share/OVMF/OVMF_VARS.fd"),
    ("/usr/share/edk2/x64/OVMF_CODE.4m.fd", "/usr/share/edk2/x64/OVMF_VARS.4m.fd"),
    ("/usr/share/edk2-ovmf/x64/OVMF_CODE.fd", "/usr/share/edk2-ovmf/x64/OVMF_VARS.fd"),
]
NAME_RX = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")


def mib(size: str) -> int:
    """'4G' / '4096M' / '4096' -> MiB"""
    s = size.upper()
    return int(s[:-1]) * 1024 if s.endswith("G") else int(s.rstrip("M"))


def human(path: Path) -> str:
    """Allocated size on the host (like du -h)."""
    n = path.stat().st_blocks * 512
    for unit in "BKMG":
        if n < 1024:
            break
        n /= 1024
    return f"{n:.1f}{unit}" if unit == "G" else f"{n:.0f}{unit}"


def ovmf() -> tuple[str, str]:
    if C.OVMF_CODE and C.OVMF_VARS:
        return C.OVMF_CODE, C.OVMF_VARS
    for pair in OVMF_PAIRS:
        if all(Path(p).exists() for p in pair):
            return pair
    die("OVMF firmware not found (install edk2-ovmf, or set OVMF_CODE/OVMF_VARS)")


def win_iso(required=True) -> Path | None:
    """The Microsoft ISO: WIN_ISO, else the newest Win*.iso in $DATA_DIR/iso."""
    if C.WIN_ISO:
        iso = Path(C.WIN_ISO)
    else:
        iso = max(ISOS.glob("Win*.iso"), key=lambda p: p.stat().st_mtime, default=None)
    if required and not (iso and iso.exists()):
        die(f"no Windows ISO: put an official one into {ISOS} (microsoft.com/software-download) or set WIN_ISO")
    return iso


# ------------------------------------------------------------------ host RAM guard

def meminfo(key: str) -> int:
    """/proc/meminfo value in MiB"""
    m = re.search(rf"^{key}:\s+(\d+)", Path("/proc/meminfo").read_text(), re.M)
    return int(m[1]) // 1024


def need_mem(want: int, what: str) -> None:
    """Refuse to start something the host can't hold. Running VMs count with the RAM
    they may still grow into, not just what they touched so far."""
    growth = sum(max(0, vm.state.get("ram", 0) - vm.rss) for vm in running())
    have = meminfo("MemAvailable") - growth
    if have < want + int(C.MEM_RESERVE):
        die(f"{what} needs ~{want} MiB RAM (+{C.MEM_RESERVE} reserve) but only {have} MiB is free "
            f"for it - stop an instance or lower RAM/WIMLIB_THREADS")


# ------------------------------------------------------------------ QMP / guest agent

class Chan:
    """Line-delimited JSON over a unix socket: QMP (QEMU monitor) or QGA (guest agent)."""

    def __init__(self, path: Path, qmp: bool):
        if not path.is_socket():
            die(f"{path.name} missing - is the instance running?")
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.settimeout(30)
        self.sock.connect(str(path))
        self.f = self.sock.makefile("rw", encoding="utf-8")
        if qmp:
            self.f.readline()                                  # greeting
            self("qmp_capabilities")

    def __call__(self, cmd: str, args: dict | None = None):
        self.f.write(json.dumps({"execute": cmd, **({"arguments": args} if args else {})}) + "\n")
        self.f.flush()
        while True:                                            # skip async events
            line = self.f.readline() or die(f"{cmd}: connection closed")
            msg = json.loads(line)
            if "error" in msg:
                die(f"{cmd}: {msg['error'].get('desc', msg['error'])}")
            if "return" in msg:
                return msg["return"]


# ------------------------------------------------------------------ layers
# A layer is a read-only qcow2 in images/layers/, backed by the layer below it. Backing
# files are stored as relative paths, so `qemu-img info --backing-chain` shows the same
# tree as `winvm layers`, and $DATA_DIR can be moved.

def layer(name: str) -> Path:
    return LAYERS / f"{name}.qcow2"


def valid(name: str) -> str:
    return name if NAME_RX.fullmatch(name) else die(f"bad name '{name}' (letters, digits, . _ -)")


def parent(img: Path) -> str | None:
    """Name of the layer an image is backed by."""
    info = json.loads(output(C.QEMU_IMG, "info", "-U", "--output=json", img))
    return Path(info["backing-filename"]).stem if "backing-filename" in info else None


def chain(img: Path) -> list[str]:
    """Layers below an image, nearest first."""
    names = []
    while p := parent(img):
        names.append(p)
        img = layer(p)
    return names


def overlay(img: Path, on: str) -> None:
    """Create an empty qcow2 at img on top of layer `on`."""
    if not layer(on).exists():
        die("no base layer - run ./winvm install" if on == "base" else f"no layer '{on}' (./winvm layers)")
    img.parent.mkdir(parents=True, exist_ok=True)
    img.unlink(missing_ok=True)
    rel = os.path.relpath(layer(on), img.parent)
    run(C.QEMU_IMG, "create", "-q", "-f", "qcow2", "-F", "qcow2", "-b", rel, img)


def layers() -> list[Path]:
    return sorted(LAYERS.glob("*.qcow2"))


def disks() -> list[Path]:
    return sorted(DISKS.glob("*.qcow2"))


# ------------------------------------------------------------------ instances

class VM:
    """An instance: working disk images/disks/<name>.qcow2 plus run/<name>/ while it runs."""

    def __init__(self, name: str, disk: Path | None = None):
        self.name = name
        self.disk = disk or DISKS / f"{name}.qcow2"
        self.dir = RUNS / name
        self.pidfile = self.dir / "qemu.pid"

    # --- state: pid from QEMU's pidfile, ports/RAM chosen at start in vm.json
    @property
    def pid(self) -> int | None:
        try:
            pid = int(self.pidfile.read_text())
            os.kill(pid, 0)
            return pid
        except (OSError, ValueError):
            return None

    @property
    def alive(self) -> bool:
        return self.pid is not None

    @property
    def state(self) -> dict:
        try:
            return json.loads((self.dir / "vm.json").read_text())
        except (OSError, ValueError):
            return {}

    @state.setter
    def state(self, value: dict) -> None:
        self.dir.mkdir(parents=True, exist_ok=True)
        (self.dir / "vm.json").write_text(json.dumps(value, indent=1) + "\n")

    @property
    def rss(self) -> int:
        """Resident memory of the QEMU process in MiB."""
        try:
            return int(re.search(r"VmRSS:\s+(\d+)", Path(f"/proc/{self.pid}/status").read_text())[1]) // 1024
        except (OSError, TypeError):
            return 0

    def fresh_vars(self) -> None:
        """New UEFI variable store (Windows boots via the fallback loader, no entries needed)."""
        self.dir.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(ovmf()[1], self.dir / "OVMF_VARS.fd")

    # --- QEMU command line
    def qemu_argv(self, *, install=False, gui=False, cdroms=(), st: dict | None = None) -> list[str]:
        st, code = st or self.state, ovmf()[0]
        a = [C.QEMU, "-name", f"winslim-{self.name},process=winslim-{self.name}", "-enable-kvm",
             "-uuid", C.VM_UUID,
             # q35 + host CPU with Hyper-V enlightenments: what Windows runs fastest on
             "-machine", "q35,hpet=off,vmport=off", "-cpu", f"host,{HYPERV}",
             "-smp", C.CPUS, "-m", f"{st['ram']}M",
             "-rtc", "base=utc,driftfix=slew", "-global", "kvm-pit.lost_tick_policy=delay",
             "-global", "ICH9-LPC.disable_s3=1", "-global", "ICH9-LPC.disable_s4=1",
             # UEFI: shared read-only firmware + this instance's variable store
             "-drive", f"if=pflash,format=raw,readonly=on,file={code}",
             "-drive", f"if=pflash,format=raw,file={self.dir}/OVMF_VARS.fd",
             # disk on virtio-scsi; discard passes guest TRIM down so qcow2 files shrink.
             # cache=unsafe while installing: a host crash means reinstalling anyway
             "-device", "virtio-scsi-pci,id=scsi0",
             "-drive", f"if=none,id=disk0,file={self.disk},format=qcow2,discard=unmap,detect-zeroes=unmap,"
                       f"cache={'unsafe' if install else 'writeback'}",
             "-device", "scsi-hd,drive=disk0,bus=scsi0.0,rotation_rate=1,bootindex=0",
             # paravirtual devices: balloon (give RAM back), rng, absolute mouse, keyboard
             "-device", "virtio-balloon-pci", "-device", "virtio-rng-pci",
             "-device", "virtio-tablet-pci", "-device", "virtio-keyboard-pci",
             # guest agent + control sockets
             "-device", "virtio-serial-pci",
             "-chardev", f"socket,id=qga0,path={self.dir}/qga.sock,server=on,wait=off",
             "-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0",
             "-qmp", f"unix:{self.dir}/qmp.sock,server=on,wait=off",
             "-monitor", f"unix:{self.dir}/monitor.sock,server=on,wait=off",
             "-vga", "std"]
        if install:
            # no NIC while installing: nothing phones home and Windows knows it is offline
            a += ["-nic", "none", "-serial", f"file:{self.dir}/install-serial.log"]
        else:
            # user-mode network: localhost-only port forwards + QEMU's private smbd for the share
            net = f"user,id=net0,hostname={self.name},hostfwd=tcp:127.0.0.1:{st['ssh']}-:22"
            if st.get("rdp"):
                net += f",hostfwd=tcp:127.0.0.1:{st['rdp']}-:3389"
            if shutil.which("smbd") or Path("/usr/sbin/smbd").exists():
                SHARE.mkdir(parents=True, exist_ok=True)
                net += f",smb={SHARE}"
            a += ["-netdev", net, "-device", "virtio-net-pci,netdev=net0,mac=52:54:00:57:53:4c",
                  "-serial", f"file:{self.dir}/serial.log"]
        for i, iso in enumerate(cdroms):                       # the first CD boots (disk is still empty)
            a += ["-drive", f"if=none,id=cd{i},media=cdrom,readonly=on,file={iso}",
                  "-device", f"ide-cd,drive=cd{i},bus=ide.{i}" + (",bootindex=1" if i == 0 else "")]
        if gui:
            a += ["-display", "gtk,zoom-to-fit=on",           # + clipboard sharing via spice-vdagent
                  "-chardev", "qemu-vdagent,id=vdagent0,clipboard=on,mouse=off",
                  "-device", "virtserialport,chardev=vdagent0,name=com.redhat.spice.0"]
        else:
            a += ["-display", "none"] + (["-vnc", f"127.0.0.1:{st['vnc']}"] if st.get("vnc") is not None else [])
        return [str(x) for x in a]

    def claim(self, ram: int) -> None:
        """Pick a free port slot (prefer the last one used) and record ports + RAM in vm.json."""
        self.state = {"ram": ram, **ports(free_slot(prefer=self.state.get("slot")))}

    # --- lifecycle
    def start(self, gui=False, on: str | None = None) -> None:
        if on and self.disk.exists() and parent(self.disk) != on:
            die(f"{self.name} is built on '{parent(self.disk)}' - ./winvm -i {self.name} reset {on} to switch")
        if self.alive:
            return log(f"{self.name} already running (pid {self.pid})")
        need(C.QEMU)
        if not self.disk.exists():
            self.reset(on or "base")
        if not (self.dir / "OVMF_VARS.fd").exists():
            self.fresh_vars()
        ram = mib(C.RAM)
        need_mem(ram, f"instance {self.name}")
        self.claim(ram)
        argv = self.qemu_argv(gui=gui) + ["-pidfile", str(self.pidfile)]
        if gui:
            with open(self.dir / "qemu.log", "w") as logf:
                sp.Popen(argv, stdout=logf, stderr=sp.STDOUT, start_new_session=True)
        else:
            run(*argv, "-daemonize")
        for _ in range(50):
            if self.alive:
                break
            time.sleep(0.1)
        else:
            die(f"QEMU failed to start (see {self.dir}/qemu.log)")
        self.ssh_config()                                      # for `Include run/*/ssh_config`
        st = self.state
        log(f"started {self.name} (pid {self.pid}) ssh=127.0.0.1:{st['ssh']}"
            + (f" rdp=127.0.0.1:{st['rdp']}" if st.get("rdp") else "")
            + (f" vnc=127.0.0.1:{5900 + st['vnc']}" if st.get("vnc") is not None else ""))

    def stop(self, timeout=120) -> None:
        if not self.alive:
            return log(f"{self.name} not running")
        self.close_ssh()
        Chan(self.dir / "qmp.sock", qmp=True)("system_powerdown")      # ACPI power button
        for _ in range(timeout):
            if not self.alive:
                return log(f"stopped {self.name}")
            time.sleep(1)
        warn("guest did not power off in time - killing")
        self.kill()

    def kill(self) -> None:
        self.close_ssh()
        if pid := self.pid:
            os.kill(pid, signal.SIGTERM)
            for _ in range(50):
                if not self.alive:
                    break
                time.sleep(0.1)
        self.pidfile.unlink(missing_ok=True)

    def reset(self, on: str) -> None:
        overlay(self.disk, on)
        self.fresh_vars()
        log(f"fresh disk for {self.name}: {' -> '.join([self.name, *chain(self.disk)])}")

    def require_stopped(self) -> None:
        if self.alive:
            die(f"{self.name} is running - ./winvm -i {self.name} stop first")

    # --- SSH
    def ssh_config(self) -> Path:
        st = self.state or die(f"{self.name} has never been started")
        cfg = self.dir / "ssh_config"
        cfg.write_text(f"""Host {self.name}
  HostName 127.0.0.1
  Port {st['ssh']}
  User {C.WIN_USER}
  IdentityFile {SSH_KEY}
  IdentitiesOnly yes
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel ERROR
  ConnectTimeout 5
  ServerAliveInterval 10
  ControlMaster auto
  ControlPath {self.dir}/mux
  ControlPersist 120
""")
        return cfg

    def close_ssh(self) -> None:
        """End the shared SSH connection (it would outlive a stopped guest for a while)."""
        if (self.dir / "mux").exists():
            sp.run(["ssh", "-F", str(self.dir / "ssh_config"), "-O", "exit", self.name],
                   stdout=sp.DEVNULL, stderr=sp.DEVNULL)

    def ssh(self, *opts: str) -> list[str]:
        """ssh argv up to and including the host name."""
        return ["ssh", "-F", str(self.ssh_config()), *opts, self.name]

    def wait_ssh(self, timeout=300) -> None:
        if (self.dir / "mux").exists() and not sp.run(   # shared connection up: nothing to wait for
                self.ssh("-O", "check"), stdout=sp.DEVNULL, stderr=sp.DEVNULL).returncode:
            return
        end = time.time() + timeout
        while sp.run(self.ssh("-o", "BatchMode=yes", "-o", "ConnectTimeout=3") + ["exit 0"],
                     stdin=sp.DEVNULL, stdout=sp.DEVNULL, stderr=sp.DEVNULL).returncode:
            if not self.alive:
                die(f"{self.name} is not running")
            if time.time() > end:
                die("timeout waiting for SSH")
            time.sleep(2)

    def up(self) -> VM:
        """Make sure the instance runs and SSH answers."""
        if not self.alive:
            self.start()
        self.wait_ssh()
        return self


def running() -> list[VM]:
    return [vm for d in sorted(RUNS.glob("*/")) if (vm := VM(d.name)).alive]


def ports(slot: int) -> dict:
    """Host ports of port slot n: base ports from the config + n (None = forward off)."""
    return {"slot": slot, "ssh": int(C.SSH_PORT) + slot,
            "rdp": int(C.RDP_PORT) + slot if C.RDP_PORT else None,
            "vnc": int(C.VNC_DISPLAY) + slot if C.VNC_DISPLAY else None}


def port_free(port: int) -> bool:
    with socket.socket() as s:
        try:
            s.bind(("127.0.0.1", port))
            return True
        except OSError:
            return False


def free_slot(prefer: int | None = None) -> int:
    taken = {vm.state.get("slot") for vm in running()}

    def ok(n: int) -> bool:
        p = ports(n)
        return n not in taken and all(port_free(x) for x in
                                      (p["ssh"], p["rdp"], p["vnc"] is not None and 5900 + p["vnc"]) if x)

    if prefer is not None and ok(prefer):
        return prefer
    slot = next((n for n in range(100) if ok(n)), None)
    return die("no free port slot") if slot is None else slot


# ------------------------------------------------------------------ build: boot ISO

def dos(text: str) -> bytes:
    """Unix -> Windows line endings."""
    return re.sub(r"\r*\n", "\r\n", text if text.endswith("\n") else text + "\n").encode()


def list_file(name: str) -> str:
    """A guest/lists/*.txt file without comments and blank lines."""
    lines = (ln.rstrip() for ln in (REPO / "guest/lists" / f"{name}.txt").read_text().splitlines())
    return "".join(f"{ln}\n" for ln in lines if ln.strip() and not ln.lstrip().startswith("#"))


def write_config_cmd(tree: Path, mode="install", preserviced=False, index="") -> None:
    """winslim/config.cmd: the knobs pe.cmd reads."""
    rev = sp.run(["git", "-C", REPO, "describe", "--always", "--dirty"], stdout=sp.PIPE, text=True,
                 stderr=sp.DEVNULL).stdout.strip() or "nogit"
    knobs = {"WIN_EDITION": C.WIN_EDITION, "WIN_INDEX": index, "WIN_STRIP_PAYLOADS": C.WIN_STRIP_PAYLOADS,
             "WIN_COMPACT": C.WIN_COMPACT, "WINSLIM_MODE": mode, "WIN_PRESERVICED": int(preserviced),
             "WINSLIM_DEBUG": C.WINSLIM_DEBUG, "WINSLIM_BUILD": f"{rev}-{time.strftime('%Y%m%d')}"}
    (tree / "winslim/config.cmd").write_bytes(dos("".join(f'set "{k}={v}"\n' for k, v in knobs.items())))


def stage_tree(tree: Path, mode="install") -> None:
    """Everything of an installer ISO except install.wim: patched WinPE, drivers, winslim/ payload."""
    iso = win_iso()
    need("7z", "wimlib-imagex", "xorriso")
    if not (VIRTIO_ISO.exists() and OPENSSH_MSI.exists()):
        cmd_fetch()
    ensure_key()
    shutil.rmtree(tree, ignore_errors=True)
    tree.mkdir(parents=True)
    threads = f"--threads={C.WIMLIB_THREADS}"

    log(f"extracting boot files from {iso.name}")
    run("7z", "x", "-y", f"-o{tree}", iso, "bootmgr", "bootmgr.efi", "boot", "efi", "sources/boot.wim", quiet=True)
    if not (tree / "efi/microsoft/boot/efisys_noprompt.bin").exists():
        die("unexpected ISO layout (no efisys_noprompt.bin)")

    log("patching boot.wim (WinPE shell -> winslim installer)")
    boot, new = tree / "sources/boot.wim", tree / "sources/boot.new.wim"
    run("wimlib-imagex", "export", boot, "2", new, "--boot", threads, quiet=True)
    for f in ("winpeshl.ini", "winslim-start.cmd"):
        (BUILD / f).write_bytes(dos((REPO / "guest" / f).read_text()))
    run("wimlib-imagex", "update", new, "1", quiet=True, text=True,
        input=f"add '{BUILD}/winpeshl.ini' /Windows/System32/winpeshl.ini\n"
              f"add '{BUILD}/winslim-start.cmd' /Windows/System32/winslim-start.cmd\n")
    new.replace(boot)
    for f in ("winpeshl.ini", "winslim-start.cmd"):
        (BUILD / f).unlink()

    log("extracting virtio drivers")
    vio = BUILD / "virtio"
    run("7z", "x", "-y", f"-o{vio}", VIRTIO_ISO, *(f"{d}/w11/amd64" for d in VIRTIO_DRIVERS),
        "virtio-win-guest-tools.exe", "cert/Virtio_Win_Red_Hat_CA.cer", quiet=True)
    for d in VIRTIO_DRIVERS:
        dst = tree / "drivers" / d.lower()
        dst.mkdir(parents=True)
        for f in (vio / d / "w11/amd64").iterdir():
            if f.is_file() and f.suffix != ".pdb":
                shutil.copy(f, dst)

    log("staging winslim scripts and payload")
    ws, pl = tree / "winslim", tree / "winslim/payload"
    pl.mkdir(parents=True)
    (ws / "pe.cmd").write_bytes(dos((REPO / "guest/pe.cmd").read_text()))
    for f in ("appx-keep", "capabilities-remove", "features-remove", "features-keep-payload",
              "services-disable", "offline-delete"):
        (ws / f"{f}.txt").write_bytes(dos(list_file(f)))
    (ws / "offline-reg.txt").write_bytes(dos((REPO / "guest/lists/offline-reg.txt").read_text()))
    write_config_cmd(tree, mode)

    xml = {"WIN_USER": C.WIN_USER, "WIN_PASSWORD": C.WIN_PASSWORD, "WIN_HOSTNAME": C.WIN_HOSTNAME,
           "WIN_TIMEZONE": C.WIN_TIMEZONE, "WIN_LOCALE": C.WIN_LOCALE, "WIN_KEYBOARD": C.WIN_KEYBOARD}
    unattend = (REPO / "guest/unattend.xml.in").read_text()
    for k, v in xml.items():
        unattend = unattend.replace(f"@{k}@", escape(v, {'"': "&quot;", "'": "&apos;"}))
    (ws / "unattend.xml").write_bytes(dos(unattend))

    for f in ("SetupComplete.cmd", "setupcomplete.ps1", "firstlogon.ps1", "common.ps1"):
        (pl / f).write_bytes(dos((REPO / "guest/payload" / f).read_text()))
    for f in ("appx-keep", "services-disable"):
        (pl / f"{f}.txt").write_bytes(dos(list_file(f)))
    ps_bool = lambda v: "$true" if v == "1" else "$false"
    (pl / "settings.ps1").write_bytes(dos(
        f"$WinUser = '{C.WIN_USER.replace(chr(39), chr(39) * 2)}'\n"
        f"$WinCompact = {ps_bool(C.WIN_COMPACT)}\n$RemoveWebView = {ps_bool(C.WIN_REMOVE_WEBVIEW)}\n"))
    shutil.copy(vio / "virtio-win-guest-tools.exe", pl)
    shutil.copy(vio / "cert/Virtio_Win_Red_Hat_CA.cer", pl / "virtio-ca.cer")
    shutil.copy(OPENSSH_MSI, pl / "OpenSSH.msi")
    keys = [SSH_KEY.with_suffix(".pub"), *(Path(p).expanduser() for p in C.SSH_EXTRA_PUBKEYS.split())]
    (pl / "authorized_keys").write_bytes(dos("".join(k.read_text() for k in keys if k.exists())))
    shutil.rmtree(vio)


def make_iso(tree: Path, out: Path, label: str) -> None:
    """Hybrid BIOS/UEFI ISO; efisys_noprompt skips 'press any key to boot from CD'."""
    log(f"writing {out.name}")
    run("xorriso", "-as", "mkisofs", "-quiet", "-iso-level", "3", "-J", "-joliet-long", "-relaxed-filenames",
        "-V", label, "-b", "boot/etfsboot.com", "-no-emul-boot", "-boot-load-size", "8", "-hide", "boot.catalog",
        "-eltorito-alt-boot", "-e", "efi/microsoft/boot/efisys_noprompt.bin", "-no-emul-boot", "-o", out, tree)


def ensure_key() -> None:
    KEYS.mkdir(parents=True, exist_ok=True)
    KEYS.chmod(0o700)
    if not SSH_KEY.exists():
        run("ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "winslim", "-f", SSH_KEY)


def run_installer(disk: Path, cdroms: list[Path], gui=False) -> str:
    """Boot an offline installer VM on `disk`, stream its [PE]/[SC]/[FL]/[WIN] progress lines
    from the serial log until QEMU exits, and return the whole log."""
    vm = VM("_install", disk)
    vm.require_stopped()
    vm.fresh_vars()
    ram = mib(C.RAM)
    need_mem(ram, "the installer VM")
    vm.claim(ram)
    serial = vm.dir / "install-serial.log"
    serial.write_bytes(b"")
    if not gui and vm.state.get("vnc") is not None:
        log(f"watch it: vncviewer 127.0.0.1:{5900 + vm.state['vnc']}  (serial log: {serial})")
    t0 = time.time()
    qemu = sp.Popen(vm.qemu_argv(install=True, gui=gui, cdroms=cdroms) + ["-pidfile", str(vm.pidfile)])
    buf = b""
    with serial.open("rb") as f:
        while True:
            done = qemu.poll() is not None                     # read once more after QEMU exits
            buf += f.read()
            *lines, buf = buf.split(b"\n")
            for ln in lines:
                if re.match(rb"\[(PE|SC|FL|WIN)", ln):
                    print(ln.decode(errors="replace").rstrip("\r"), flush=True)
            if done:
                break
            time.sleep(0.5)
    vm.pidfile.unlink(missing_ok=True)
    log(f"QEMU exited (rc={qemu.returncode}) after {(time.time() - t0) / 60:.0f} min")
    return serial.read_text(errors="replace")


def iso_from_capture(cap: Path, tree: Path) -> None:
    """Capture disk -> install.wim (libguestfs) -> solid LZMS install.esd (wimlib) -> standalone ISO."""
    wim = BUILD / "install.wim"
    if cap.exists():
        log("pulling the captured image off the capture disk")
        wim.unlink(missing_ok=True)
        r = run("guestfish", "--ro", "-a", cap, "run", ":", "mount", "/dev/sda4", "/", ":",
                "download", "/WINSLIM-CAPTURE-DONE", BUILD / "capture.ok", ":",
                "download", "/install.wim", wim, check=False, stderr=sp.DEVNULL)
        if r.returncode:
            die(f"capture failed - see VNC/screenshot; disk kept at {cap}")
        for f in (cap, BUILD / "capture.iso", BUILD / "capture.ok"):
            f.unlink(missing_ok=True)
    if not wim.exists():
        die(f"no captured image ({cap} or {wim}) - run ./winvm iso")
    if running():
        die("an instance is running - stop it before the export (both need lots of RAM)")
    threads = int(C.WIMLIB_THREADS)
    need_mem(threads * 1024, f"solid LZMS export with {threads} threads")
    log(f"re-exporting as solid LZMS install.esd (wimlib, {threads} threads; slow but light)")
    esd = tree / "sources/install.esd"
    for old in (tree / "sources").glob("install.*"):
        old.unlink()
    run("wimlib-imagex", "export", wim, "1", esd, "--solid", f"--threads={threads}")
    wim.unlink()
    if esd.stat().st_size >= 4 << 30:
        die("install.esd is over 4 GiB (ISO9660 limit)")
    write_config_cmd(tree, "install", preserviced=True, index="1")   # same payload: plain apply, no servicing
    make_iso(tree, SLIM_ISO, "WINSLIM_FULL")
    shutil.rmtree(tree)


def finalize(disk: Path) -> None:
    """Installed disk -> read-only, zstd-compressed layer 'base' + a fresh disk for the default instance."""
    if C.WIN_REMOVE_WEBVIEW == "1" and shutil.which("guestfish"):
        # firstlogon deletes WebView2, but the shell keeps a few files locked; finish offline
        log("removing WebView2 leftovers offline (libguestfs)")
        r = run("guestfish", "--rw", "-a", disk, "-i", check=False, text=True, stdout=sp.DEVNULL,
                stderr=sp.DEVNULL, input='-rm-rf "/Program Files (x86)/Microsoft/EdgeWebView"\n-fstrim /\n')
        if r.returncode:
            warn("guestfish failed - leftovers kept")
    log("creating the golden base layer")
    base, tmp = layer("base"), layer("base").with_suffix(".tmp")
    LAYERS.mkdir(parents=True, exist_ok=True)
    zstd = ["-c", "-o", "compression_type=zstd"] if C.COMPRESS_BASE == "1" else []
    run(C.QEMU_IMG, "convert", "-p", "-O", "qcow2", *zstd, disk, tmp)
    tmp.replace(base)
    base.chmod(0o444)
    disk.unlink()
    VM(C.INSTANCE).reset("base")
    log(f"base layer: {base} ({human(base)} on disk)")
    log("done - ./winvm sh")


# ------------------------------------------------------------------ command registry

COMMANDS: dict[str, tuple] = {}
RAW = set()   # commands whose arguments are passed through verbatim (to PowerShell, ssh, scp, ...)


def arg(*flags, **kw):
    return flags, kw


def command(*args, raw=False, aliases=()):
    """Register cmd_<name> as subcommand <name>; its docstring's first line is the help text."""
    def deco(fn):
        name = fn.__name__.removeprefix("cmd_").replace("_", "-")
        COMMANDS[name] = (fn, args, aliases)
        if raw:
            RAW.update((name, *aliases))
        return fn
    return deco


def current(a) -> VM:
    return VM(valid(a.instance))


