@command(arg("args", nargs="*", metavar="ARG", help="agent command [json] | exec PROGRAM [ARGS]"), raw=True)
def cmd_ga(a):
    """qemu-guest-agent (works without network), e.g. ga guest-info | ga exec ipconfig /all"""
    agent = Chan(current(a).dir / "qga.sock", qmp=False)
    cmd, *rest = a.rest or ["guest-ping"]
    if cmd != "exec":
        return print(json.dumps(agent(cmd, json.loads(rest[0]) if rest else None), indent=1))
    rest or die("usage: winvm ga exec PROGRAM [ARGS...]")
    pid = agent("guest-exec", {"path": rest[0], "arg": rest[1:], "capture-output": True})["pid"]
    while not (st := agent("guest-exec-status", {"pid": pid})).get("exited"):
        time.sleep(0.2)
    sys.stdout.write(base64.b64decode(st.get("out-data", "")).decode("utf-8", "replace"))
    sys.stderr.write(base64.b64decode(st.get("err-data", "")).decode("utf-8", "replace"))
    return st.get("exitcode", 0)


@command(arg("size", nargs="?", help="e.g. 2G; omit to show"))
def cmd_balloon(a):
    """show or set guest RAM live via virtio-balloon (returns memory to the host)"""
    qmp = Chan(current(a).dir / "qmp.sock", qmp=True)
    if a.size:
        qmp("balloon", {"value": mib(a.size) << 20})
        time.sleep(2)
    print(f"guest RAM: {qmp('query-balloon')['actual'] >> 20} MiB")


@command(arg("file", nargs="?"))
def cmd_screenshot(a):
    """save a PNG of the guest screen"""
    vm = current(a)
    out = Path(a.file or vm.dir / "screen.png").resolve()
    Chan(vm.dir / "qmp.sock", qmp=True)("screendump", {"filename": str(out), "format": "png"})
    print(out)


@command(arg("--gui", action="store_true"))
def cmd_cmdline(a):
    """print the QEMU command line `start` uses"""
    vm = current(a)
    st = vm.state if vm.alive else {"ram": mib(C.RAM), **ports(vm.state.get("slot", 0))}
    print(shlex.join(vm.qemu_argv(gui=a.gui, st=st)))


# ------------------------------------------------------------------ commands: layers & instances

@command()
def cmd_layers(a):
    """list layers: size, what each is built on, who uses it"""
    users: dict[str, list[str]] = {}
    for img in layers() + disks():
        if p := parent(img):
            users.setdefault(p, []).append(img.stem if img.parent == LAYERS else f"[{img.stem}]")
    print(f"{'LAYER':<16} {'SIZE':>6}  {'ON':<12} USED BY   ([x] = instance x)")
    for img in layers():
        print(f"{img.stem:<16} {human(img):>6}  {parent(img) or '-':<12} {' '.join(users.get(img.stem, []))}")


@command(arg("name", help="new layer name"))
def cmd_save(a):
    """freeze the instance's disk as read-only layer NAME and continue on top of it"""
    vm, name = current(a), valid(a.name)
    vm.require_stopped()
    vm.disk.exists() or die(f"{vm.name} has no disk")
    dst = layer(name)
    if dst.exists():
        die(f"layer '{name}' already exists")
    below = parent(vm.disk)
    vm.disk.replace(dst)
    run(C.QEMU_IMG, "rebase", "-u", "-F", "qcow2", "-b", f"{below}.qcow2", dst)   # relative to layers/
    dst.chmod(0o444)
    overlay(vm.disk, name)
    log(f"saved layer '{name}' ({human(dst)}): {' -> '.join([vm.name, *chain(vm.disk)])}")


@command(arg("layer", nargs="?", help="default: the layer the disk is on now"))
def cmd_reset(a):
    """discard the instance's changes: fresh empty disk on its layer (or on LAYER)"""
    vm = current(a)
    vm.require_stopped()
    on = a.layer or (vm.disk.exists() and parent(vm.disk)) or "base"
    vm.reset(valid(on))


@command(arg("name"))
def cmd_drop(a):
    """delete layer NAME (refused while a layer or instance is built on it)"""
    name = valid(a.name)
    if name == "base":
        die("use ./winvm clean --base for the golden image")
    layer(name).exists() or die(f"no layer '{name}'")
    if users := [img.stem for img in layers() + disks() if parent(img) == name]:
        die(f"built on '{name}': {', '.join(users)} - drop/rm/reset those first")
    layer(name).unlink()
    log(f"dropped layer '{name}'")


@command()
def cmd_rm(a):
    """delete the instance: its disk (unsaved changes!) and run folder"""
    vm = current(a)
    vm.require_stopped()
    vm.disk.unlink(missing_ok=True)
    shutil.rmtree(vm.dir, ignore_errors=True)
    log(f"removed instance {vm.name}")


@command(arg("--base", action="store_true", help="also the base layer and all instance disks"),
         arg("--all", action="store_true", help="also ISOs we built and the download cache"))
def cmd_clean(a):
    """remove build leftovers [--base] [--all]"""
    if running():
        die("instances are running - stop them first")
    if (a.base or a.all) and (extra := [img.stem for img in layers() if img.stem != "base"]):
        die(f"saved layers would break: {', '.join(extra)} - ./winvm drop them first")
    shutil.rmtree(BUILD, ignore_errors=True)
    for f in [INSTALL_DISK, *IMAGES.glob("**/*.tmp")]:
        f.unlink(missing_ok=True)
    if a.base or a.all:
        for f in [layer("base"), *disks()]:
            f.unlink(missing_ok=True)
        shutil.rmtree(RUNS, ignore_errors=True)
    if a.all:
        for f in (BOOT_ISO, SLIM_ISO):
            f.unlink(missing_ok=True)
        shutil.rmtree(CACHE, ignore_errors=True)
    log("cleaned")


# ------------------------------------------------------------------ main

def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(
        prog="winvm", formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Build and drive slim, unattended Windows VMs on QEMU/KVM.",
        epilog=f"config: {REPO}/config.env (override in config.local.env)   data: {DATA}")
    p.add_argument("-i", "--instance", default=C.INSTANCE, metavar="NAME",
                   help=f"instance to act on (default: {C.INSTANCE}); goes before the command")
    sub = p.add_subparsers(title="commands", metavar="<command>")
    for name, (fn, args, aliases) in COMMANDS.items():
        doc = fn.__doc__ or ""
        sp_ = sub.add_parser(name, aliases=aliases, help=doc.splitlines()[0], description=doc,
                             formatter_class=argparse.RawDescriptionHelpFormatter)
        for flags, kw in args:
            sp_.add_argument(*flags, **kw)
        sp_.set_defaults(fn=fn)

    # raw commands get everything after their name untouched (PowerShell, ssh, scp arguments)
    i, a = 0, None
    while i < len(argv) and argv[i].startswith("-"):
        i += 2 if argv[i] in ("-i", "--instance") else 1
    if i < len(argv) and argv[i] in RAW:
        a = p.parse_args(argv[: i + 1])
        a.rest = argv[i + 1:]
    else:
        a = p.parse_args(argv)
    if not hasattr(a, "fn"):
        p.print_help()
        return 1
    return a.fn(a) or 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
